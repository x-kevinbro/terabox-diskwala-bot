# Your Telegram bot token from @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Terabox account cookie(s) — required for Terabox links.
# Comma-separate multiple accounts to rotate them.
TERABOX_COOKIES=ndus=YOUR_NDUS_VALUE; lang=en

# Max file size (MB) to upload into Telegram. Official Bot API limit is 50.
MAX_FILE_MB=48

# Point to a local telegram-bot-api server to raise the limit to 2GB:
# TELEGRAM_API_ROOT=http://localhost:8081
# MAX_FILE_MB=2000

# REQUEST_TIMEOUT_MS=25000
# DOWNLOAD_DIR=./downloads
# EXTRA_HOSTS=some-new-terabox-mirror.com
