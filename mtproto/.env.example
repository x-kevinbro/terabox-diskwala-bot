# ============================================================
#  Telegram MTProto credentials  <-- PUT YOUR VALUES HERE
# ============================================================
# API_ID and API_HASH come from https://my.telegram.org
#   -> log in -> "API development tools" -> create an app
# BOT_TOKEN comes from @BotFather in Telegram.
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=123456:your_bot_token_here

# ============================================================
#  Optional settings (safe defaults already applied)
# ============================================================
# Anyone can use the bot. Set to false + ALLOWED_USERS to restrict.
PUBLIC_BOT=true
# ALLOWED_USERS=11111111,22222222

# Upload ceiling in MB. MTProto allows up to 2000 for normal bots.
MAX_FILE_MB=2000
# Refuse files that would not fit on the instance's small ephemeral disk.
MAX_DISK_MB=2600

# Memory tuning: 1 MiB chunks keep RAM flat on a 512 MB instance.
CHUNK_BYTES=1048576
# Keep at 1 on free Koyeb; higher means parallel transfers and more RAM/disk.
MAX_CONCURRENT_JOBS=1

REQUEST_TIMEOUT_MS=30000
PROGRESS_INTERVAL_SEC=6

# Temp locations (ephemeral disk). Files are deleted right after sending.
DOWNLOAD_DIR=/tmp/downloads
SESSION_DIR=/tmp/session

# Health/UptimeRobot port. Koyeb injects PORT automatically.
PORT=8000

# Resolver upstreams (change only if they move).
# DISKWALA_RESOLVER_URL=https://diskwala-dl-six.vercel.app/api/scrap
# TERABOX_RESOLVER_URL=https://disktera.vercel.app/api/download
